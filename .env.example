# 参考小说批次摘要提取（init 流程，建议 flash 模型）
DATA_BUILDER_BACKEND=openai
DATA_BUILDER_MODEL=deepseek-v4-flash
DATA_BUILDER_BASE_URL=https://api.deepseek.com
DATA_BUILDER_API_KEY=sk-xxxxxxxxxx
DATA_BUILDER_WIRE_API=chat_completions

# 全书设计与舞台设计（建议 pro 模型）
ADAPTIVE_BUILDER_BACKEND=openai
ADAPTIVE_BUILDER_MODEL=deepseek-v4-pro
ADAPTIVE_BUILDER_BASE_URL=https://api.deepseek.com
ADAPTIVE_BUILDER_API_KEY=sk-xxxxxxxxxx
ADAPTIVE_BUILDER_WIRE_API=chat_completions

# 故事情节、逐章章纲、正文与轻量辅助任务（建议 flash 模型）
ADAPTIVE_BUILDER_LITE_BACKEND=openai
ADAPTIVE_BUILDER_LITE_MODEL=deepseek-v4-flash
ADAPTIVE_BUILDER_LITE_BASE_URL=https://api.deepseek.com
ADAPTIVE_BUILDER_LITE_API_KEY=sk-xxxxxxxxxx
ADAPTIVE_BUILDER_LITE_WIRE_API=chat_completions

# 正文精修：未单独配置时继承写作生产模型，包括所选后端。
HUMANIZE_BUILDER_BACKEND=openai
HUMANIZE_BUILDER_MODEL=
HUMANIZE_BUILDER_BASE_URL=
HUMANIZE_BUILDER_API_KEY=
HUMANIZE_BUILDER_WIRE_API=chat_completions

# Antigravity 可选后端（需自行安装官方 agy 并在终端登录 Google 账号）
# 把对应组的 BACKEND 改为 antigravity_cli，并清空旧 API 的 MODEL，
# 或填入 agy models 列出的准确模型 ID；BASE_URL/API_KEY/WIRE_API 不用于 CLI。
# 各组均支持下面的 CLI 字段，留空路径时自动查找官方可执行文件。
DATA_BUILDER_CLI_PATH=
DATA_BUILDER_CLI_AGENT=
DATA_BUILDER_CLI_EFFORT=medium
ADAPTIVE_BUILDER_CLI_PATH=
ADAPTIVE_BUILDER_CLI_AGENT=
ADAPTIVE_BUILDER_CLI_EFFORT=medium
ADAPTIVE_BUILDER_LITE_CLI_PATH=
ADAPTIVE_BUILDER_LITE_CLI_AGENT=
ADAPTIVE_BUILDER_LITE_CLI_EFFORT=medium
HUMANIZE_BUILDER_CLI_PATH=
HUMANIZE_BUILDER_CLI_AGENT=
HUMANIZE_BUILDER_CLI_EFFORT=medium

# 安装、登录、调度与限额恢复说明：docs/antigravity.md
